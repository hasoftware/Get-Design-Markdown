# Sao chép thành .env để ghi đè giá trị mặc định (không bắt buộc).

# Thư mục gốc chứa kết quả: output/<domain>/
GDM_OUTPUT_DIR=output

# Số phần tử tối đa lấy computed style trên mỗi trang
GDM_MAX_ELEMENTS=3000

# Thời gian chờ tải trang (giây)
GDM_TIMEOUT=45

# Trình duyệt dùng để mở trang: auto (Chromium của Playwright → Edge → Chrome),
# chromium, msedge hoặc chrome
GDM_BROWSER=auto
